{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.anulum.li/scpn-control/schemas/report-refresh-v1.json",
  "title": "SCPN Control append-only validation report refresh",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "source_report",
    "source_commit",
    "refresh_evidence_time_utc",
    "evidence_class",
    "orientation_only",
    "producer_command",
    "producers",
    "dependency_lock_sha256",
    "host",
    "sampling",
    "producer_payload",
    "raw_capture_preserved_in_internal_custody",
    "raw_capture_sha256",
    "claim_boundary",
    "failures",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "scpn-control.validation-report-refresh.v1"},
    "lineage_id": {"type": "string", "minLength": 1},
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^validation/reports/.+\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_commit": {"$ref": "#/$defs/git_sha"},
    "refresh_evidence_time_utc": {"type": "string", "format": "date-time"},
    "evidence_class": {"const": "local_proxy"},
    "orientation_only": {"const": true},
    "producer_command": {"type": "string", "minLength": 1},
    "producers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "kernel", "loaded", "producer_context"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "class": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "loaded": {"const": true},
        "producer_context": {"type": "object"}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "repeats", "warmup"],
      "properties": {
        "samples": {"type": "integer", "minimum": 1},
        "repeats": {"type": "integer", "minimum": 1},
        "warmup": {"type": "integer", "minimum": 0}
      }
    },
    "producer_payload": {"type": "object"},
    "raw_capture_preserved_in_internal_custody": {"const": true},
    "raw_capture_sha256": {"$ref": "#/$defs/sha256"},
    "claim_boundary": {"$ref": "#/$defs/claim_boundary"},
    "failures": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_evidence",
        "scientific_admission",
        "production_admission",
        "public_claim_allowed",
        "rationale"
      ],
      "properties": {
        "current_evidence": {"const": true},
        "scientific_admission": {"const": false},
        "production_admission": {"const": false},
        "public_claim_allowed": {"const": false},
        "rationale": {"type": "string", "minLength": 1}
      }
    }
  }
}
