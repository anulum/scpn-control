{
  "name": "scpn-control-studio-web",
  "version": "0.1.0",
  "private": true,
  "description": "The SCPN-CONTROL Control Studio UI remote — a Module Federation 2.x remote exposing the ControlStudioPanel the SCPN Studio Hub federates at runtime.",
  "license": "AGPL-3.0-or-later",
  "author": "Miroslav Šotek <protoscience@anulum.li>",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docs:api": "typedoc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@module-federation/vite": "1.22.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
